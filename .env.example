# ─── Required ────────────────────────────────────────────────────────────────
# PostgreSQL 15+ connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bloom

# Better Auth session signing secret (32+ chars). Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Public origin of the app (used for auth callbacks and links sent to trusted contacts)
BETTER_AUTH_URL=http://localhost:3000

# Master key that wraps every user's data key (32 bytes, base64). Generate: npm run keys:master
# Losing this key makes all health data unreadable. Store it in a secret manager, not in git.
BLOOM_MASTER_KEY=
BLOOM_MASTER_KEY_ID=v1

# ─── Mochi's AI (optional — without it Mochi says the AI isn't connected) ─────
# anthropic | openai | google
AI_PROVIDER=anthropic
# Anthropic default is claude-sonnet-5-5. OpenAI and Google need an explicit model id.
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ─── SOS alerts by Web Push (optional — without it SOS uses call/text on the phone only)
# Generate a pair: npm run keys:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact for the push services
VAPID_SUBJECT=mailto:safety@example.com

# ─── Journeys (optional) ──────────────────────────────────────────────────────
# Shared secret for the scheduler that calls /api/cron/journeys every minute
CRON_SECRET=

# ─── Email (optional — enables password reset) ───────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=BLOOM <no-reply@example.com>
