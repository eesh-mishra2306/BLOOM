    "keys:vapid": "web-push generate-vapid-keys",
    "cron:journeys": "node scripts/journey-cron.mjs",
    "test:a11y": "node scripts/a11y.mjs",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npm run db:migrate; fi && next build"
  },
